# salin jadi .env lalu sesuaikan, .env tidak ikut repo
APP_ENV=local

# sesuaikan user dan password PostgreSQL lokal, postgres:// diubah otomatis ke postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/two_beans
# database khusus pytest, namanya wajib berakhiran _test
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/two_beans_test

# kunci HMAC token sesi, minimal 32 karakter
# buat dengan: python -c "import secrets; print(secrets.token_urlsafe(36))"
SECRET_KEY=ganti-dengan-48-karakter-acak

# origin frontend yang boleh mengirim request pengubah data, dipisah koma
# tambahkan origin API (mis. http://localhost:8000) supaya POST lewat Swagger /docs tidak ditolak 403
ALLOWED_ORIGINS=http://localhost:5173
# true kalau aplikasi dilayani lewat https
COOKIE_SECURE=false

SESSION_IDLE_MINUTES=60
SESSION_MAX_HOURS=12
LOGIN_RATE_LIMIT=5/minute
BCRYPT_ROUNDS=12
